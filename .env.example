# ---------------------------------------------------------------------------
# Copy to .env and edit before running docker compose.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# REQUIRED. Must be at least 32 characters — HS256 rejects anything shorter,
# and the services refuse to start rather than sign with a weak key.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data
JWT_ISSUER=EarthScanBackend
JWT_AUDIENCE=EarthScanUsers
JWT_EXPIRATION_MS=604800000

# --------------------------------------------------------------- data stores
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
MONGO_PORT=27017

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ------------------------------------------------------------------ bootstrap
# Leave the password blank to skip creating a bootstrap administrator. Setting
# it creates one on first startup — change it immediately after logging in.
BOOTSTRAP_ADMIN_EMAIL=admin@earthscan.in
BOOTSTRAP_ADMIN_PASSWORD=

# Seeds five demo listings. Keep this false anywhere real, or the fake prices
# will pollute the district averages the investment analysis is computed from.
SEED_DEMO_LISTINGS=true

# ------------------------------------------------------------------- frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
